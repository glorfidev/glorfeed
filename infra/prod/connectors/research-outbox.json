{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "${env:CDC_RESEARCH_DB_USER}",
  "database.password": "${env:CDC_RESEARCH_DB_PASSWORD}",
  "database.dbname": "glorfeed_research",
  "topic.prefix": "glorfeed-research",
  "plugin.name": "pgoutput",
  "slot.name": "glorfeed_research_outbox",
  "publication.name": "glorfeed_research_outbox",
  "publication.autocreate.mode": "disabled",
  "snapshot.mode": "no_data",
  "slot.drop.on.stop": "false",
  "heartbeat.interval.ms": "10000",
  "heartbeat.action.query": "UPDATE public.debezium_heartbeat SET touched_at = NOW() WHERE id = 1",
  "table.include.list": "public.outbox_event,public.debezium_heartbeat",
  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.predicate": "outboxTable",
  "predicates": "outboxTable",
  "predicates.outboxTable.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.outboxTable.pattern": "glorfeed-research\\.public\\.outbox_event",
  "transforms.outbox.route.by.field": "aggregate_type",
  "transforms.outbox.table.field.event.key": "aggregate_id",
  "transforms.outbox.table.fields.additional.placement": "event_type:header:type,id:header:id",
  "transforms.outbox.table.expand.json.payload": "true",
  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.partitions": "1",
  "topic.creation.default.cleanup.policy": "delete",
  "topic.creation.default.retention.ms": "259200000",
  "topic.creation.default.retention.bytes": "536870912"
}
