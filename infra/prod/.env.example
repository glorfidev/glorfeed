# Create /opt/glorfeed/infra/prod/.env on the server before deploying.
# Fill in all three passwords; blank values deliberately prevent startup.
# Admin credentials are for managing PostgreSQL, not for application services.
POSTGRES_USER=glorfeed_admin
POSTGRES_PASSWORD=

TOPIC_DB_USER=glorfeed_topic
TOPIC_DB_PASSWORD=

RESEARCH_DB_USER=glorfeed_research
RESEARCH_DB_PASSWORD=
