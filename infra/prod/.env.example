# Create /opt/glorfeed/infra/prod/.env on the server before deploying.
# Fill in every password; blank values deliberately prevent startup.
# Admin credentials are for managing PostgreSQL, not for application services.
POSTGRES_USER=glorfeed_admin
POSTGRES_PASSWORD=

TOPIC_DB_USER=glorfeed_topic
TOPIC_DB_PASSWORD=

RESEARCH_DB_USER=glorfeed_research
RESEARCH_DB_PASSWORD=

# Server-side manual research. Keep the OpenAI key only in the server .env.
OPENAI_API_KEY=
RESEARCH_GATEWAY_ENABLED=false
RESEARCH_INTERNAL_TOKEN=

# Dedicated logical-replication accounts. They are provisioned with REPLICATION
# and SELECT on their own outbox plus heartbeat-table SELECT/UPDATE only.
CDC_TOPIC_DB_USER=glorfeed_topic_cdc
CDC_TOPIC_DB_PASSWORD=
CDC_RESEARCH_DB_USER=glorfeed_research_cdc
CDC_RESEARCH_DB_PASSWORD=

RESEARCH_AI_MODEL=gpt-6-luna

# Public Keycloak client settings; no browser client secret is used.
KEYCLOAK_URL=https://auth.glorfindela.dev
KEYCLOAK_REALM=glorfeed
KEYCLOAK_CLIENT_ID=glorfeed-frontend

# API token validation settings. The issuer must exactly match the realm URL.
AUTH_ISSUER_URI=https://auth.glorfindela.dev/realms/glorfeed
AUTH_JWK_SET_URI=https://auth.glorfindela.dev/realms/glorfeed/protocol/openid-connect/certs
AUTH_AUDIENCE=glorfeed-topic-service
